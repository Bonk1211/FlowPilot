# Backend only. Copy to .env in the repository root if overriding defaults.
FLOWPILOT_DATABASE_URL=sqlite:///./flowpilot.db
# Optional backend key. Without it, deterministic findings remain available.
# Never put secrets in VITE_* variables or commit the local .env file.
GEMINI_API_KEY=
FLOWPILOT_GEMINI_MODEL=gemini-3.5-flash-lite
FLOWPILOT_REASONING_ENABLED=true
FLOWPILOT_REASONING_TIMEOUT_SECONDS=12
