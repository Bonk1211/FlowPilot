# Backend only. Copy to .env in the repository root if overriding defaults.
# Never put secrets in VITE_* variables or commit the local .env file.
FLOWPILOT_DATABASE_URL=sqlite:///./flowpilot.db

# Gemini: answer interpretation and adaptive question generation.
# Paste your key, then set FLOWPILOT_REASONING_ENABLED=true when ready.
# Use a model available to your account that supports the thinking settings below.
GEMINI_API_KEY=
FLOWPILOT_GEMINI_MODEL=gemini-3.5-flash-lite
# Prioritize quick follow-up questions; a stronger model remains an optional override.
FLOWPILOT_INCIDENT_QUESTION_MODEL=gemini-3.5-flash-lite
# Includes reference retrieval; expiry retains the eligible baseline questions.
FLOWPILOT_INCIDENT_QUESTION_TIMEOUT_SECONDS=8
# auto uses Jev when enabled, otherwise Gemini's validated preferred question.
FLOWPILOT_INCIDENT_QUESTION_SELECTOR=auto
FLOWPILOT_REASONING_ENABLED=false
FLOWPILOT_REASONING_TIMEOUT_SECONDS=12
FLOWPILOT_INCIDENT_INTERPRETATION_THINKING=low
FLOWPILOT_INCIDENT_GENERATION_THINKING=low

# Gemini File Search reference RAG. Run npm run db:migrate, then npm run rag:index.
# With synthetic_only policy, use npm run rag:index -- --allow-reference-upload
# to allow only the S932 reference upload. Incident policy remains unchanged.
FLOWPILOT_INCIDENT_RAG_ENABLED=false
FLOWPILOT_INCIDENT_RAG_TIMEOUT_SECONDS=12

# Jev through OpenRouter: next-step selection, answer readiness and question categories.
# Paste your key, then set FLOWPILOT_INCIDENT_JEV_ENABLED=true when ready.
OPENROUTER_API_KEY=
FLOWPILOT_JEV_GATEWAY=openrouter
FLOWPILOT_INCIDENT_JEV_ENABLED=false
FLOWPILOT_JEV_MODEL=typesafe/jev-1.13
FLOWPILOT_JEV_TIMEOUT_SECONDS=3
FLOWPILOT_JEV_MIN_PROBABILITY=0.75
FLOWPILOT_JEV_ANSWER_MIN_PROBABILITY=0.90
# Direct TypeSafe access instead: gateway=typesafe, model=jev-latest, and this key:
# FLOWPILOT_JEV_API_KEY=

# Only synthetic incident data may be sent to providers by default.
# Allowed values: synthetic_only, permitted, disabled.
FLOWPILOT_INCIDENT_EXTERNAL_DATA_POLICY=synthetic_only

# Restart the backend after edits. Use npm run dev or make dev for live providers.
# npm run dev:mock and make start always disable providers.
# With providers disabled, the deterministic investigation remains available.

# Optional local photo storage overrides. Defaults are under .cache/vision/.
# FLOWPILOT_VISION_STORAGE_DIR=/absolute/path/to/assessments
# FLOWPILOT_VISION_MODEL_DIR=/absolute/path/to/model

# ElevenLabs Scribe realtime voice input (backend key; never expose it to Vite).
ELEVENLABS_API_KEY=
FLOWPILOT_INCIDENT_VOICE_ENABLED=false
# Set voice_enabled=true after supplying the key. Hands-free uses browser TTS for replies.
# For real technician speech/live incidents, external_data_policy must be permitted.

# Outlook drafts: register a Microsoft Entra Web app first (see docs/OUTLOOK.md).
# These credentials stay on the backend. Restart after configuring them.
FLOWPILOT_OUTLOOK_CLIENT_ID=
FLOWPILOT_OUTLOOK_CLIENT_SECRET=
FLOWPILOT_OUTLOOK_TENANT=common
FLOWPILOT_OUTLOOK_REDIRECT_URI=http://localhost:5173/api/incident-outlook/callback
